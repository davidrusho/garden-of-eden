# device infor for homeassistant
MQTT_IDENTIFIER=gardyn_03
MQTT_BASETOPIC=gardyn
MQTT_DEVICE_MODEL="gardyn 3.0"
MQTT_VERSION="1.0.0"

# MQTT broker config
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=gardyn
MQTT_PASSWORD=somepassword
MQTT_KEEPALIVE_INTERVAL=60

WATER_LOW_CM=11

UPPER_CAMERA_DEVICE=/dev/video0
LOWER_CAMERA_DEVICE=/dev/video2
UPPER_IMAGE_PATH=/tmp/upper_camera.jpg
LOWER_IMAGE_PATH=/tmp/lower_camera.jpg
CAMERA_RESOLUTION="640x480"
IMAGE_INTERVAL_SECONDS=3600

# JPEG quality, 1-100. Anything outside that range is refused and the default
# is used instead, because an out-of-range value is the bug this setting fixes:
# fswebcam was invoked with no --jpeg flag, so gd's quality parameter was never
# set and the captured frames carried "quality = 255" in their own JPEG comment.
#
# Measured on the Pi with identical -S 2 -F 2 flags:
#   lower 640x480    no flag 325,070 | q95 151,093 | q85 83,003 | q75 66,197
#   upper 1600x1200  no flag 440,713 | q95 187,254 | q85 90,381 | q75 76,754
#
# 85 rather than 95 because 95 only buys back half the saving; per cycle that is
# ~748 KB down to ~169 KB. Set UPPER_/LOWER_CAMERA_JPEG_QUALITY to override one
# camera; both fall back to CAMERA_JPEG_QUALITY when unset.
CAMERA_JPEG_QUALITY=85
#UPPER_CAMERA_JPEG_QUALITY=85
#LOWER_CAMERA_JPEG_QUALITY=85
