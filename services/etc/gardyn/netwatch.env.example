# Template for /etc/gardyn/netwatch.env — required configuration for
# bin/gardyn-netwatch.py (the network watchdog installed by
# services/etc/systemd/system/gardyn-netwatch.service).
#
#     sudo install -d -m 0755 /etc/gardyn
#     sudo install -m 0644 services/etc/gardyn/netwatch.env.example \
#          /etc/gardyn/netwatch.env
#     sudoedit /etc/gardyn/netwatch.env      # replace every CHANGEME
#
# THERE IS NO DEFAULT, AND THAT IS THE POINT. gardyn-netwatch reboots the host
# it runs on when it decides the network is gone. The values below are one
# specific LAN's topology, and this is a public repository, so a built-in
# fallback would hand a clone somebody else's addressing together with a
# reboot policy aimed at it. Every incomplete state — file absent, a key
# missing, a CHANGEME left in place — makes the script refuse to run and exit
# non-zero, so systemd marks the unit failed and says so. It will never quietly
# fall back to a target this repository chose.
#
# The file is read by the script itself, so `KEY=value` lines, `#` comments,
# blank lines, a leading `export`, and surrounding quotes are all accepted.
# It is also a valid systemd EnvironmentFile= if you ever want it there too.

# Hosts to ping, comma- or space-separated. The network counts as UP if ANY of
# them answers, so use hosts that fail independently — a gateway and one other
# always-on box. Requiring one particular host to agree would make that host
# rebooting look identical to this Pi's radio dying.
#
# Two is the sensible number and three is the hard ceiling: each target costs
# up to 8s on a failing run, and the whole run has to finish inside the unit's
# TimeoutStartSec=90 alongside the TCP probe and a reconnect attempt. A config
# listing more is refused rather than silently killed mid-reconnect every tick.
GARDYN_NETWATCH_PING_TARGETS=CHANGEME-gateway-address,CHANGEME-second-host-address

# The MQTT broker this Pi actually talks to. An independent, non-ICMP modality:
# when ICMP is filtered or rate-limited upstream this still answers, and it
# tests the path that carries the grow-light commands rather than a proxy for
# it. It carries more weight than it looks — with wlan0 down there is no route,
# both pings exit 2 ("could not measure"), and the whole decision rests here.
GARDYN_NETWATCH_TCP_HOST=CHANGEME-broker-address

# Optional. 1883 is the IANA-registered MQTT port and is the only field with a
# default, because it says nothing about anybody's topology.
GARDYN_NETWATCH_TCP_PORT=1883

# The wlan0 NetworkManager profile to reactivate, identified by UUID rather
# than by name so a renamed connection fails loudly at reconnect time instead
# of silently activating some other profile. Find it with:
#
#     nmcli -g UUID,NAME,DEVICE connection show
#
# Must be a real UUID (8-4-4-4-12 hex). A connection NAME here would fail every
# reconnect with nothing but the journal to show for it, so the shape is
# checked at load time rather than during an outage.
GARDYN_NETWATCH_WLAN_UUID=CHANGEME-00000000-0000-0000-0000-000000000000
