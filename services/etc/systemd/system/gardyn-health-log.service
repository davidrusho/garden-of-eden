[Unit]
Description=Gardyn Pi host-health sample (T-473.2)
Documentation=https://www.raspberrypi.com/documentation/computers/os.html
# No network dependency on purpose. The single most valuable sample is the one
# taken while the network is DOWN, so requiring network-online would suppress
# exactly the readings this exists to capture.

[Service]
Type=oneshot
# Unprivileged: `gardyn` is in the `video` group (verified on the host), so
# vcgencmd works without root, and /sys/class/thermal, /proc/net/wireless,
# /proc/uptime and /proc/meminfo are all world-readable.
User=gardyn
ExecStart=/usr/bin/python3 /home/gardyn/garden-of-eden/bin/gardyn-health-log.py
SyslogIdentifier=gardyn-health

# T-479: the Uptime Kuma push URL, which carries a secret token and therefore
# lives outside this PUBLIC repository. The leading `-` makes the file
# optional, so a checkout without it still starts and simply does not push -
# the script reports `kuma_push=skipped_no_url` and Kuma's own interval turns
# the resulting silence into a DOWN, which is the honest outcome anyway.
#
# Deployed 0640 root:gardyn. systemd reads EnvironmentFile= as root before
# dropping to User=, so 0600 root:root should also work; 0640 is the belt to
# that braces and costs nothing, since `gardyn` is the only non-root account.
#
# THE CONSUMING MONITOR'S INTERVAL IS PART OF THIS DESIGN and lives only in
# Kuma's database, where nothing in this repo can assert it. Uptime Kuma
# monitor 27 `service-gardyn-netwatch`, interval 900s, resend_interval 4.
# It MUST stay above ~310s (this timer's 300s period + AccuracySec=10s + run
# time) or a normal cycle reads as a missed heartbeat and the monitor flaps.
# 900s = three periods, so two pushes can be lost without a false page. The
# ceiling matters too: it is how long an unmeasurable probe stays silent
# before Kuma calls it DOWN, since those paths push nothing at all.
EnvironmentFile=-/etc/gardyn/kuma-netwatch.env

# A diagnostic must never become the outage it monitors. Without this, the
# kernel's OOM killer scores by RSS and would reap the long-lived mqtt.py -
# the grow-light and pump controller - in preference to this short-lived
# sampler. That is backwards: this unit is the one that is safe to lose.
#
# MemoryMax=64M was removed 2026-07-31 (T-473.4 review): it was INERT, not
# merely redundant. The Pi firmware puts `cgroup_disable=memory` on this
# kernel's command line, so the root cgroup carries only `cpu io pids` and no
# descendant can enable a controller the root lacks. `systemctl show` reported
# MemoryMax=67108864 regardless - the configured value, not an enforced one -
# which made it a false green. Do not add it back without first checking
# /sys/fs/cgroup/cgroup.controllers. OOMScoreAdjust writes
# /proc/<pid>/oom_score_adj and is unaffected, so it carries this alone.
OOMScoreAdjust=500

# Cut journald chatter. systemd logs "Starting"/"Deactivated"/"Finished" at
# info for every tick, which is 3 entries of noise per 1 entry of signal -
# ~60% of this unit's journal footprint, and `journalctl -t gardyn-health`
# never shows them anyway. LogLevelMax also applies to PID 1's messages ABOUT
# this unit, so raising the script's own priority above the cut is required:
# without SyslogLevel, LogLevelMax=notice would drop the sample line too.
SyslogLevel=notice
LogLevelMax=notice

# Bounded so a wedged binary cannot leave the unit running into the next tick.
# Required explicitly: per systemd.service(5) the start timeout is DISABLED by
# default for Type=oneshot.
#
# Raised 30 -> 60 for T-479. The first pass said 45 on the arithmetic
# "vcgencmd 5 + nmcli 5 + two systemctl 5 + push 5 = 25s", and the push term
# was wrong: per the Python docs urlopen's `timeout` bounds "blocking
# operations like the connection attempt" INDIVIDUALLY, not the call as a
# whole, so connect + send + read is up to 15s, not 5. Real worst case is
# ~35s, plus interpreter start on a single-core ARMv6 host where even
# `python3 -c pass` costs 325ms.
#
# Getting this wrong is not a slow sample, it is a LOST one: print(record)
# runs after the push, so a SIGTERM here destroys the health sample as well
# as the heartbeat, at exactly the moment both are worth having. 60s keeps a
# ~25s margin and is still comfortably inside the 300s timer period.
TimeoutStartSec=60
TimeoutStopSec=10
Nice=10
IOSchedulingClass=idle

# Read-only diagnostic; it needs no privileges and no write access. It DOES
# now make one outbound HTTP request (T-479), which needs no capability as an
# unprivileged user, so CapabilityBoundingSet= stays empty. The push target is
# a bare IP, deliberately: a hostname would put a DNS resolver on the path of
# the one signal that has to survive a sick network.
# NOTE: ProtectHome= in ANY form breaks ExecStart, because the script lives
# under /home/gardyn.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
