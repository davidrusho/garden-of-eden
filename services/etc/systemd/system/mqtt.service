[Unit]
Description=MQTT Service
Requires=pigpiod.service
Wants=network-online.target
After=network-online.target pigpiod.service
# Never give up restarting. systemd's default start limit (5 starts in 10s)
# combined with the default RestartSec=100ms means a service that exits
# immediately — as this one did when the broker was unreachable at boot —
# burns the whole budget in under a second and parks the unit in `failed`
# permanently. A router reboot that brought the Pi up before the broker used
# to leave the garden with no controller until someone noticed.
StartLimitIntervalSec=0

[Service]
# NOT the default Type=simple. Under `simple` systemd considers the unit
# started as soon as fork() returns, before execve() has been attempted at
# all — systemd.service(5): "systemctl start command lines for simple
# services will report success even if the service's binary cannot be invoked
# successfully (for example because the selected User= doesn't exist, or the
# service binary is missing)." That made the `|| record_failure` guard in
# bin/install-systemd-units.sh unable to fire for the one unit that matters:
# a rebuilt-but-broken venv, a missing interpreter or an import error at
# startup all produced a green `systemctl start` and a green installer run
# over a dead grow-light controller.
#
# Type=exec waits for both fork() AND execve() to succeed — same page:
# "systemctl start command lines for exec services will report failure when
# the service's binary cannot be invoked successfully." Measured, not
# assumed: with an ExecStart naming a path that does not exist, `systemctl
# start` exits 0 under no-Type and under Type=simple, and exits 1 under
# Type=exec.
#
# It does NOT wait for readiness — a process that execs and then dies on its
# first broker connection still reports started. Closing that would need
# Type=notify plus sd_notify() support in mqtt.py. Restart=always below is
# what covers it today.
#
# Available since systemd 240; this host runs 252.
Type=exec
User=gardyn
# Creates /var/lib/gardyn owned by User= at mode 0755 and exports
# $STATE_DIRECTORY pointing at it (systemd.exec(5), verified against the man
# page on this host — systemd 252). light_scheduler.py persists the last
# brightness it applied there, which is what lets a boot with no network HOLD
# the previous phase instead of guessing at a clock it cannot trust.
#
# NOT under WorkingDirectory=, which is a git checkout: state written into a
# working tree is one `git clean` away from being lost, and would show up as
# an untracked file in every deploy.
#
# Losing this directory degrades exactly one thing — the unsynced-clock branch
# falls back to GARDYN_LIGHT_UNSYNCED_FALLBACK instead of holding. It is not
# on the path of any ordinary tick, so a failure here cannot stop the
# photoperiod.
StateDirectory=gardyn
WorkingDirectory=/home/gardyn/garden-of-eden
ExecStart=/home/gardyn/garden-of-eden/venv/bin/python /home/gardyn/garden-of-eden/mqtt.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
